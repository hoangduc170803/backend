COMPOSE_PROJECT_NAME=wes-prod
DOCKERHUB_NAMESPACE=aubot
PUBLIC_URL=http://10.0.101.51:18080
WES_BIND_ADDRESS=0.0.0.0
WES_HTTP_PORT=18080

OPENTCS_PROPERTIES_FILE=./deploy/opentcs-kernel.prod.properties
OPENTCS_BIND_ADDRESS=0.0.0.0
OPENTCS_HTTP_PORT=19200
OPENTCS_RMI_REGISTRY_PORT=1499
OPENTCS_RMI_SERVICE_PORT=59000
OPENTCS_RMI_BIND_ADDRESS=10.0.101.51
OPENTCS_RMI_ADVERTISED_HOST=10.0.101.51

MQTT_NETWORK_NAME=fms-wcs-server_default
MQTT_URL=mqtt://mqtt-broker:1883
MQTT_USERNAME=
MQTT_PASSWORD=

SIMULATOR_HTTP_PORT=8091
SIM_MQTT_HOST=mqtt-broker
SIM_MQTT_PORT=1883
SIM_MQTT_USERNAME=
SIM_MQTT_PASSWORD=
SIMULATOR_TOKEN=

POSTGRES_USER=wes
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=wes
JWT_SECRET=replace-with-at-least-32-random-characters

OPENTCS_MAP_AUTO_LOAD=false
OPENTCS_MAP_PATH=maps/v7-vda5050.xml
DISPATCH_MATCHER=hungarian
VEHICLE_TYPE=vda5050

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
