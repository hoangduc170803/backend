# ── Server ──
PORT=3000
WEB_ORIGIN=http://localhost:5173

# ── Database (DATABASE_URL takes precedence over PG* if set) ──
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/wes
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=wes

# ── Auth ──
JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL=1d
REFRESH_TTL_DAYS=7
RESET_TTL_MINUTES=30

# ── Frontend links (where invite / reset-password links point) ──
APP_URL=http://localhost:5174

# ── Mail — pluggable provider (src/mail/mail-provider.interface.ts) ──
# MAIL_PROVIDER picks one explicitly: 'resend' | 'smtp' | 'log'. Leave unset to
# auto-detect: RESEND_API_KEY set -> resend; else SMTP_HOST set -> smtp; else 'log'
# (just logs what would have been sent — the safe zero-config default).
# MAIL_PROVIDER=resend

# Option A — Resend (recommended for real delivery without owning a mail server):
# an HTTP email API — no SPF/DKIM/PTR to manage yourself, the provider's domain
# reputation does the work. Sandbox key can only send FROM onboarding@resend.dev
# until you verify your own domain in the Resend dashboard.
# RESEND_API_KEY=re_...
# MAIL_FROM="WES Console <onboarding@resend.dev>"

# Option B — Mailpit: local-only catcher, nothing ever leaves your machine.
# Safe for testing the send code path without touching real inboxes.
# UI: http://localhost:8025 (docker-compose.yml starts it).
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM="WES Console <no-reply@wes.local>"

# Option C — self-hosted Postfix (`wes-mailserver` in docker-compose.yml): sends for
# real, directly to the recipient's mail server (no relay, no auth). Without your own
# domain's SPF/DKIM records, providers like Gmail now reject it outright (550) rather
# than filing it as spam — only useful once you own a domain and can add those records.
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1587
# SMTP_SECURE=false
# SMTP_TLS_REJECT_UNAUTHORIZED=false
# MAIL_FROM="WES Console <no-reply@wes.local>"

# Option D — real SMTP account (e.g. Gmail with an app password): sends through an
# inbox with actual sending reputation, so mail reaches the recipient's inbox.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# MAIL_FROM="WES Console <your-email@gmail.com>"

# ── Operating read model (GET /operating/orders, /operating/stream/v2) ──
# Transport orders that ended stay in the active view only as a short recent window; order history
# is the transport-order registry. Defaults: 100 orders, 15 minutes.
# OPERATING_RECENT_TERMINAL_MAX=100
# OPERATING_RECENT_TERMINAL_TTL_MS=900000

# ── openTCS (existing) ──
# Native dev: http://localhost:55200
# Devcontainer: http://host.docker.internal:55200
OPENTCS_KERNEL_URL=http://localhost:55200
OPENTCS_MAP_AUTO_LOAD=false
OPENTCS_MAP_PATH=maps/v7-vda5050.xml
DISPATCH_MATCHER=hungarian

# ── AGV simulator (docker compose up -d simulator) ──
# The shared headless simulator behind the "Mô phỏng AGV" tool. SIMULATOR_TOKEN is optional
# in dev; when set, docker compose passes the same value to the container.
SIMULATOR_URL=http://127.0.0.1:8091
# SIMULATOR_TOKEN=

# Vehicle operation vocabulary. Must match the loaded map's allowedOperation:
#   loopback -> PICK_UP / DROP_OFF   (maps/v7.xml, v7-bidir.xml, v7-simple.xml)
#   vda5050  -> liftUp  / liftDown   (maps/v7-vda5050.xml)
VEHICLE_TYPE=vda5050